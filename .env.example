# Copy this file to .env and fill in real values. Never commit the real .env.

# Google AI Studio API key, used to call a Gemma model (e.g. gemma-3-27b-it)
# via the Generative Language API. Leave blank to run TrustRAG without live
# answer generation — authorization, retrieval, prompt scanning, delegation,
# and audit logging all work fully offline without this key.
GOOGLE_API_KEY=

# Gemma model name served by Google AI Studio.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Embedding model for retrieval. Both options run locally with no API key.
#   all-MiniLM-L6-v2           real semantic embeddings via ONNX Runtime
#                              (downloads ~80 MB once on first start)
#   trustrag-local-hashing-v1  offline word-hashing fallback, lower quality
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths (safe to leave as defaults for the demo).
CHROMA_PERSIST_DIR=data/chroma_store
AUDIT_LOG_PATH=data/audit_log.jsonl
DEMO_USERS_PATH=data/demo_users.json
# Default corpus: GitLab Handbook snapshot. For the original 7 synthetic
# documents use DOCUMENTS_DIR=data/sample_docs and ACL_PATH=data/demo_acl.json
DOCUMENTS_DIR=data/handbook
ACL_PATH=data/handbook_acl.json
DELEGATIONS_PATH=data/delegations.json

# Number of chunks retrieved per query.
RETRIEVAL_TOP_K=4
