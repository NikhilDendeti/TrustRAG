# Never bake secrets or local state into the image.
.env
.env.*
!.env.example

# Local Python/Node environments — rebuilt fresh inside the image.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
frontend/node_modules/
frontend/dist/

# Local runtime state — must not ship inside the image; mount a volume at
# /app/data on Railway for this to persist across deploys instead.
data/chroma_store/
data/audit_log.jsonl
data/delegations.json.tmp

# VCS / editor / misc. (data/**/*.md and data/sample_docs/*.md are the
# document corpus itself — never exclude markdown under data/).
.git/
.github/
.gitignore
.DS_Store
data/bipia/
